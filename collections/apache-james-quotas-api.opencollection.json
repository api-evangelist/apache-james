{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache James WebAdmin REST Domains Quotas API",
    "version": "3.9.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Quotas",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apache james Apache James WebAdmin Get User Quota",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8000/quota/users/:username",
            "params": [
              {
                "name": "username",
                "value": "user@example.com",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the storage and message quota settings for a user."
        },
        {
          "info": {
            "name": "Apache james Apache James WebAdmin Update User Quota",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://localhost:8000/quota/users/:username",
            "params": [
              {
                "name": "username",
                "value": "user@example.com",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Set storage and message quota for a specific user."
        }
      ]
    }
  ],
  "bundled": true
}